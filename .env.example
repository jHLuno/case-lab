# Supabase (Client-side — used by popup)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (Server-side — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# CRM Password (Server-side only — set in Vercel Dashboard)
CRM_PASSWORD=

# Case Lab III payment mode and TipTop Pay widget (the mode must match the deployment).
TIPTOP_TEST_TERMINAL_ID=
TIPTOP_LIVE_TERMINAL_ID=
CASE_LAB_3_PAYMENT_MODE=

# Case Lab III provider credentials (server-side only - never expose to browser).
TIPTOP_TEST_PUBLIC_ID=
TIPTOP_TEST_API_SECRET=
TIPTOP_LIVE_PUBLIC_ID=
TIPTOP_LIVE_API_SECRET=
KASSIR_TEST_PUBLIC_ID=
KASSIR_TEST_API_SECRET=
KASSIR_LIVE_PUBLIC_ID=
KASSIR_LIVE_API_SECRET=
KASSIR_SELLER_INN=

# Case Lab III ticket email and server secrets (server-side only).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CASE_LAB_3_ALERT_EMAIL=
CASE_LAB_3_TOKEN_SECRET=
CASE_LAB_3_CRON_SECRET=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# JWT signing secret (Server-side only — must be a separate random value from
# CRM_PASSWORD, at least 32 characters. Generate with: openssl rand -base64 32)
JWT_SECRET=
