    "build": "NODE_OPTIONS=--disable-warning=DEP0205 next build",
    "start": "NODE_OPTIONS=--disable-warning=DEP0205 next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs && npm run test:case-lab-3-payments",
    "test:case-lab-3-payments": "tsx --test tests/case-lab-3-payments/**/*.test.ts",
    "test:case-lab-3-db": "node scripts/run-case-lab-3-db.mjs",
    "test:case-lab-3-db:local": "supabase test db"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.105.4",
    "@zxing/browser": "^0.2.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.3",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "next": "16.2.10",
    "nodemailer": "^10.0.1",
    "ogl": "^1.0.11",
    "pdfkit": "^0.20.2",
    "postprocessing": "^6.39.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.170.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "sharp": "^0.34.5",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "to-ico": "^1.1.5",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
